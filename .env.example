NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=openai/gpt-5.4-mini
LLM_MODEL_DEFAULT=openai/gpt-5.4-mini
LLM_MODEL_INTENT=openai/gpt-5.4-mini
LLM_MODEL_STRATEGY=openai/gpt-5.4-mini
LLM_MODEL_SCORING=openai/gpt-5.4-mini
LLM_MODEL_SYNTHESIS=openai/gpt-5.5
LLM_MODEL_ADJUDICATOR=openai/gpt-5.5
LLM_MODEL_BALANCED_DEFAULT=~openai/gpt-mini-latest
LLM_MODEL_BALANCED_INTENT=~openai/gpt-mini-latest
LLM_MODEL_BALANCED_STRATEGY=~openai/gpt-mini-latest
LLM_MODEL_BALANCED_SCORING=~google/gemini-flash-latest
LLM_MODEL_BALANCED_SYNTHESIS=openai/gpt-5.5
LLM_MODEL_BALANCED_ADJUDICATOR=openai/gpt-5.5
LLM_TIMEOUT_MS=10000
PROVIDER_SEARCH_OPENAI_MODEL=gpt-5.4-mini
PROVIDER_SEARCH_CLAUDE_MODEL=claude-sonnet-4-5
PROVIDER_SEARCH_GEMINI_MODEL=gemini-2.5-flash

CORE_API_KEY=
GITHUB_TOKEN=
# SEC EDGAR requires a descriptive app/contact identity. Replace with your real contact for live use.
SEC_USER_AGENT=AgentSearchTool/0.1 (contact: your-email@example.com)
SEMANTIC_SCHOLAR_API_KEY=

PIPELINE_TIMEOUT_MS=45000
SOURCE_TIMEOUT_MS=8000
MAX_CONCURRENCY=6
MAX_REPAIR_ROUNDS=4
REPAIR_TIME_BUDGET_MS=120000
PRERANK_MAX_LLM_CHUNKS=18
STAGE6_SCORING_CONCURRENCY=3
SYNTHESIS_REVIEW_TIMEOUT_MS=25000
OPENROUTER_PRICING_CACHE_TTL_MS=86400000
DEDUP_SIMILARITY_THRESHOLD=0.85
DEFAULT_TOKEN_BUDGET=4000
SCORING_THRESHOLD=0.2

LIVE_API_TESTS=0
ENABLE_DEBUG_INTERNALS=0
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
RELIABILITY_DB_PATH=./data/source-reliability.sqlite
